        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var selectedDateMs = getDateFromFormat(newValue, g_user_date_format);
    var selectedDate = new Date(selectedDateMs);
    var today = new Date();

    today.setHours(0, 0, 0, 0);
    selectedDate.setHours(0, 0, 0, 0);

    if (selectedDate > today) {
        g_form.addErrorMessage('Purchase date cannot be in the future.');
        g_form.clearValue('refund_date');
    } else {
        g_form.clearMessages();
    }
}]]></script>
